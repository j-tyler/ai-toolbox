+def ship_order(connection: sqlite3.Connection, order_id: int) -> Order:
+    with connection:
+        result = connection.execute(
+            "UPDATE orders SET status = ? WHERE id = ? AND status = ?",
+            (OrderStatus.SHIPPED.value, order_id, OrderStatus.CONFIRMED.value),
+        )
+        if result.rowcount != 1:
+            raise ValueError("Shipping requires an existing confirmed order")
+    return get_order(connection, order_id)
